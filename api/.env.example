# ==========================================
# APPLICATION
# ==========================================
NODE_ENV=development
PORT=3333
APP_NAME="Sistema de Gestão Escolar"

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/grafos?schema=public"
# Produção (Railway): use o Transaction Pooler do Supabase na porta 6543.
# Acrescente: pgbouncer=true&connection_limit=5&pool_timeout=10&connect_timeout=10
# As migrations são aplicadas pelo Supabase CLI no GitHub Actions; a API não
# precisa de DIRECT_URL nem deve executar migrations ao iniciar.

# ==========================================
# JWT AUTHENTICATION
# ==========================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_AVATARS_BUCKET=avatars

# ==========================================
# SECURITY
# ==========================================
BCRYPT_ROUNDS=10

# ==========================================
# CORS
# ==========================================
CORS_ORIGINS=http://localhost:3333,http://localhost:4200

# ==========================================
# RATE LIMITING
# ==========================================
THROTTLE_TTL=60
THROTTLE_LIMIT=300
SLOW_REQUEST_MS=200
SLOW_QUERY_MS=200

# Opcional. Use um Redis na mesma região do Railway quando houver mais de uma
# réplica da API; sem esta variável, a aplicação usa cache local em memória.
REDIS_URL=
ENABLE_SWAGGER=false

# ==========================================
# FILE UPLOAD
# ==========================================
MAX_FILE_SIZE=5242880
UPLOAD_DEST=./uploads

# ==========================================
# PAGINATION
# ==========================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ==========================================
# REDIS CACHE
# ==========================================
REDIS_HOST=
REDIS_PORT=6379
