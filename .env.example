# Environment
NODE_ENV=production

# PostgreSQL Database
POSTGRES_DB=grafos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# API Backend
API_PORT=3333
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Bootstrap Global Admin
BOOTSTRAP_GLOBAL_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_GLOBAL_ADMIN_PASSWORD=change-this-password
BOOTSTRAP_GLOBAL_ADMIN_CPF=00000000000
BOOTSTRAP_GLOBAL_ADMIN_NAME=Global Admin
BOOTSTRAP_GLOBAL_ADMIN_INSTITUTION_ID=1

# Frontend
FRONTEND_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3333
